# Midnight Youkai Radio — Environment Configuration
# Copy this file to .env and fill in your values.

# MiMo API (required for DJ voice)
MIMO_API_KEY=your-mimo-api-key-here
MIMO_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1

# Icecast passwords (match icecast_midnight.xml)
MYR_SOURCE_PASSWORD=your-source-password
MYR_ADMIN_PASSWORD=your-admin-password

# DJ voices (optional)
MYR_DJ_VOICE=Chloe          # English: Mia, Chloe, Dean, Milo
MYR_DJ_VOICE_ZH=冰糖        # Chinese: 冰糖, 茉莉, 白桦, 苏打

# Ports (optional)
MYR_ICECAST_PORT=8001
MYR_WEB_PORT=9999

# yt-dlp proxy (optional, for network restrictions)
YTDLP_PROXY=socks5://127.0.0.1:40000
